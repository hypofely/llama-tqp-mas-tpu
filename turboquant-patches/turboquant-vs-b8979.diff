+template [[host_name("kernel_turbo_flash_p2_dv96")]]  kernel turbo_flash_p2_t kernel_turbo_flash_p2<96>;
+template [[host_name("kernel_turbo_flash_p2_dv128")]] kernel turbo_flash_p2_t kernel_turbo_flash_p2<128>;
