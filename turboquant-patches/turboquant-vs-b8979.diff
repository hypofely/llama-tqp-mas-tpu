+// 4-entry magnitude LUT (positive values only, ascending order)
+// Used with ALU sign application to halve constant cache divergence
+constant half turbo_mag_3bit_h[4] = {
+    0.021460h, 0.065717h, 0.117832h, 0.190685h
+};
