+    reg = type4(float4(
+        float(turbo_centroids_4bit_h[(qb0     ) & 0xF]) * norm,
+        float(turbo_centroids_4bit_h[(qb0 >> 4) & 0xF]) * norm,
+        float(turbo_centroids_4bit_h[(qb1     ) & 0xF]) * norm,
+        float(turbo_centroids_4bit_h[(qb1 >> 4) & 0xF]) * norm
+    ));
+}
